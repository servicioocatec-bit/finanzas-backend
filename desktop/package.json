{
  "name": "control-finanzas-studio",
  "version": "11.0.0",
  "description": "Control Finanzas Studio — finanzas personales con asesor IA (Ocaranza Ing.)",
  "author": "Ocaranza Ing. <contacto@ocaranza.cl>",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "cl.ocaranza.controlfinanzas",
    "productName": "Control Finanzas Studio",
    "copyright": "© Ocaranza Ing.",
    "directories": {
      "buildResources": "build",
      "output": "instaladores"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Control Finanzas Studio"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Finanzas Studio"
    }
  }
}
